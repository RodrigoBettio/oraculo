# ============================================================
# ORÁCULO - Configuração de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NÃO commite o .env no Git (ele já está no .gitignore).
# ============================================================

# Ambiente: development | production
ENVIRONMENT=production
APP_SECRET_KEY=gere-uma-chave-segura-com-openssl-rand-hex-32

# --- Telegram (obtenha em https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=oraculo_session
TELEGRAM_TARGET_FOLDER=Estudos

# --- Gemini API (Google AI Studio - Pool de Chaves) ---
# Chave única:
GEMINI_API_KEY=
# Pool de múltiplas chaves (separadas por vírgula):
GEMINI_API_KEYS=
# Máximo de workers paralelos de estudo:
MAX_STUDY_WORKERS=8

# --- Google Drive (OAuth 2.0 de Conta Pessoal) ---
# ID da pasta raiz compartilhada com você:
GOOGLE_DRIVE_FOLDER_ID=
# URL de callback do OAuth (ajuste para seu domínio em produção):
OAUTH_REDIRECT_URI=https://oraculo.seudominio.com/auth/google/callback

# --- Diretórios ---
DATA_DIR=./data
VIDEOS_DIR=./data/videos
PROCESSED_DIR=./data/processed
AGENTS_DIR=./data/agents

# --- Limpeza Automática de Vídeos ---
VIDEO_RETENTION_HOURS=24
